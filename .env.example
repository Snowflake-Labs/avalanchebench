# Credential-free manifest payload generated by `avbench setup`.
AVBENCH_DEPLOYMENT_MANIFEST_B64=

# Agent Snowflake connection settings are consumed by the Harbor environment.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PAT=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=

# Evaluator settings. Use PAT/OAuth credentials with access to the three models.
CORTEX_TOKEN_TYPE=PROGRAMMATIC_ACCESS_TOKEN
CORTEX_JUDGE_OUTPUT_LIMIT=4096
AVBENCH_JUDGE_CONTEXT_MODE=section_first_fallback
AVBENCH_INCLUDE_PRIVATE_PROMPTS=
SNOWFLAKE_ACCOUNT_URL=https://<account_identifier>.snowflakecomputing.com
CORTEX_PAT=
CORTEX_REST_TIMEOUT_SECONDS=180

